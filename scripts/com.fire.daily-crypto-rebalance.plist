<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fire.daily-crypto-rebalance</string>

    <!-- Daily crypto rebalance for Account 4. Replaces the in-process
         APScheduler job from api/main.py (retired 2026-05-05 after a
         long-uptime drift incident).

         Schedule: 8:05 PM laptop-local time. Hour=20 was chosen
         pragmatically because (a) launchd interprets
         StartCalendarInterval in laptop-local TZ, NOT in the TZ env
         var (set TZ=UTC below for the child script's logs only — it
         does NOT change launchd's scheduler), and (b) we want the fire
         to land while the laptop is in FullWake. LaunchAgents queue
         StartCalendarInterval during darkwake and only fire on next
         FullWake (observed 2026-05-06: scheduled 00:05 EDT, queued
         through darkwake, fired at 02:05 EDT). 8:05 PM is reliably
         FullWake time for this user.

         When the user is in EDT (UTC-4): fires at 00:05 UTC ✓
         When traveling: fires at evening laptop-local. The strategy
         uses 21d momentum on crypto so a few-hour intraday offset is
         signal noise. Update Hour to match local evening if the user
         settles in a new TZ for >1 week.

         Cloud target post-Fly migration: Fly Cron Machines, which
         honor schedule TZ properly and don't depend on laptop power
         state. See DEPLOYMENT_PLAN.md. -->

    <!-- TZ=UTC env var below: makes the *child script*'s log
         timestamps appear in UTC for easy correlation with the
         rebalance journal. Has NO effect on launchd's scheduler. -->


    <key>ProgramArguments</key>
    <array>
        <string>/Users/george/.local/bin/uv</string>
        <string>run</string>
        <string>python3</string>
        <string>/Users/george/Desktop/Projects/FIRE/scripts/daily_crypto_rebalance.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/george/Desktop/Projects/FIRE</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>20</integer>
        <key>Minute</key>
        <integer>5</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/george/Desktop/Projects/FIRE/data/daily_rebalance_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/george/Desktop/Projects/FIRE/data/daily_rebalance_stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/george</string>
        <key>TZ</key>
        <string>UTC</string>
    </dict>
</dict>
</plist>
