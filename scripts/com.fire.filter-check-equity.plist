<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fire.filter-check-equity</string>

    <!-- Equity-scope filter check: SPY 200d MA filter for A1/A2.
         Fires every 4h via StartInterval (matching the crypto plist).
         Was StartCalendarInterval(16:30) but macOS silently dropped the
         once-daily fire after a deferred run from a closed-laptop day,
         leaving the agent unfired for >24h with no error. StartInterval
         is a relative timer that re-arms reliably on wake and isn't
         susceptible to that bookkeeping bug. Whipsaw risk from intraday
         fires is negligible (SPY 7% above MA at install). Pre-Fly.io
         migration only — Fly cron is the durable answer. -->

    <key>ProgramArguments</key>
    <array>
        <string>/Users/george/.local/bin/uv</string>
        <string>run</string>
        <string>python3</string>
        <string>/Users/george/Desktop/Projects/FIRE/scripts/filter_check.py</string>
        <string>--filter</string>
        <string>spy</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/george/Desktop/Projects/FIRE</string>

    <key>StartInterval</key>
    <integer>14400</integer>

    <key>StandardOutPath</key>
    <string>/Users/george/Desktop/Projects/FIRE/data/filter_check_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/george/Desktop/Projects/FIRE/data/filter_check_stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/george</string>
        <key>FIRE_FILTER_CHECK_SOURCE</key>
        <string>launchd-equity</string>
        <!-- Silence macOS notifications from filter_check.py — the
             dashboard Ops tab (see OPS_DASHBOARD_PLAN.md) is the
             system's notification surface going forward. -->
        <key>FIRE_DISABLE_NOTIFICATIONS</key>
        <string>1</string>
    </dict>
</dict>
</plist>
